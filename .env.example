# Price service (api/). Copy to .env.local, which is git-ignored.

# Server: the token every /api request must send as X-Funancial-Token. Any long random string.
FUNANCIAL_ACCESS_TOKEN=
# Server: the origin of the deployed web app, allowed through CORS beside the built-in ones.
FUNANCIAL_APP_ORIGIN=
# Server: the key the advisor (POST /api/advisor) calls Claude with, and optionally another model than
# claude-opus-5-5. Without the key the route answers 503 and the app keeps its Basic check.
# Never give either a VITE_ prefix: that would put the key in the app.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# App: where the app finds the price service, and the same token as FUNANCIAL_ACCESS_TOKEN.
# Vite bundles VITE_ variables into the app, so anyone holding the app can read the token.
VITE_FUNANCIAL_API_URL=
VITE_FUNANCIAL_API_TOKEN=
