# The settings the service (api/) and the app read: names only, never values. Copy to .env.local,
# which is git-ignored, for a local run; the deployed service keeps them in Vercel's Environment
# Variables. docs/accounts.md says how to make each account one.

# Server: the token every /api request must send as X-Funancial-Token. Any long random string.
FUNANCIAL_ACCESS_TOKEN=
# Server: the origin of the deployed web app, allowed through CORS beside the built-in ones.
FUNANCIAL_APP_ORIGIN=

# App: where the app finds the price service, and the same token as FUNANCIAL_ACCESS_TOKEN.
# Vite bundles VITE_ variables into the app, so anyone holding the app can read the token.
VITE_FUNANCIAL_API_URL=
VITE_FUNANCIAL_API_TOKEN=

# Accounts (docs/accounts.md). Vercel's Upstash integration adds the database's address and token.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 32 random bytes in base64, which unlock a copy for "forgot password". Keep it in a password manager.
SERVER_MASTER_KEY=
# The Gmail that sends "forgot password" emails, and a Google app password for it.
GMAIL_USER=
GMAIL_APP_PASSWORD=
